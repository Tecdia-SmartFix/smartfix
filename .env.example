# ── LLM (required) ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Admin auth + alert notifications via Resend ─────────────────────────────
# Sign up at https://resend.com (free tier: 100 emails/day, no card needed),
# create an API key, paste here.
RESEND_API_KEY=re_your_resend_api_key_here

# Comma-separated allowlist of admin emails. Only these addresses can:
#   - request a magic-link sign-in (POST /auth/request-link)
#   - receive alert emails when /query fires an alert
# Empty value = no admins (safe default for fresh clones).
ADMIN_EMAILS=you@example.com

# Public-facing base URL the magic-link emails point at. In dev this is the
# Vite dev server, which proxies /auth/* to the FastAPI backend.
APP_BASE_URL=http://localhost:5173

# From-address used on outbound emails. Resend's `onboarding@resend.dev`
# works for unverified accounts and can send to any inbox; replace with
# your verified domain once you set one up in the Resend dashboard.
# MAIL_FROM="Tecdia SmartFix <admin@your-verified-domain.com>"

# ── Alert tuning (optional) ────────────────────────────────────────────────
# Min alert_score (severity × significance) that fires an email + record.
# ALERT_THRESHOLD=12
